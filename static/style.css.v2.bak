:root {
  --bg: #0a0e0c;
  --panel: #101612;
  --line: #1e2a23;
  --text: #d6e3da;
  --dim: #7a8e82;
  --green: #3ddc84;
  --yellow: #f5c542;
  --red: #ff5d5d;
}

* { box-sizing: border-box; }

body {
  margin: 0 auto;
  max-width: 720px;
  padding: 16px;
  background: var(--bg);
  color: var(--text);
  font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
  line-height: 1.45;
}

header { text-align: center; margin-bottom: 14px; }

h1 {
  margin: 8px 0 4px;
  font-size: 1.6rem;
  letter-spacing: 0.04em;
}

.glitch {
  text-shadow: 1px 0 var(--red), -1px 0 var(--green);
  animation: flicker 7s infinite;
}

@keyframes flicker {
  0%, 92%, 100% { text-shadow: 1px 0 var(--red), -1px 0 var(--green); transform: none; }
  94% { text-shadow: 4px 0 var(--red), -4px 0 var(--green); transform: translateX(2px); }
  96% { text-shadow: -3px 0 var(--red), 3px 0 var(--green); transform: translateX(-2px); }
}

@media (prefers-reduced-motion: reduce) { .glitch { animation: none; } }

.tagline { margin: 0 0 10px; color: var(--dim); font-size: 0.85rem; }

.zones { display: flex; gap: 8px; justify-content: center; }

.zone {
  font-size: 0.7rem;
  padding: 2px 10px;
  border-radius: 999px;
  border: 1px solid currentColor;
}
.zone.green { color: var(--green); }
.zone.yellow { color: var(--yellow); }
.zone.red { color: var(--red); }

#chat {
  height: 52vh;
  min-height: 260px;
  overflow-y: auto;
  padding: 12px;
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: 10px;
}

.msg {
  margin: 8px 0;
  padding: 8px 10px;
  max-width: 88%;
  border-radius: 8px;
  border: 1px solid var(--line);
  word-wrap: break-word;
}

.msg.user {
  margin-left: auto;
  background: #14201a;
  border-color: #24402f;
}

.msg.bot { background: #0d1310; }
.msg.pending .text { color: var(--dim); font-style: italic; }

.who {
  display: block;
  font-size: 0.7rem;
  color: var(--dim);
  margin-bottom: 2px;
}

.tag {
  display: inline-block;
  margin-top: 4px;
  padding: 0 7px;
  font-size: 0.65rem;
  border-radius: 999px;
  border: 1px solid var(--dim);
  color: var(--dim);
}
.tag.taught, .tag.teach { color: var(--green); border-color: var(--green); }
.tag.gpt { color: var(--yellow); border-color: var(--yellow); }
.tag.error { color: var(--red); border-color: var(--red); }

.inputbar { display: flex; gap: 8px; margin-top: 10px; }

input {
  flex: 1;
  padding: 10px;
  background: var(--panel);
  color: var(--text);
  border: 1px solid var(--line);
  border-radius: 8px;
  font-family: inherit;
  font-size: 1rem;
}
input:focus { outline: 1px solid var(--green); }

button {
  padding: 10px 16px;
  background: var(--green);
  color: #04110a;
  border: 0;
  border-radius: 8px;
  font-family: inherit;
  font-weight: bold;
  cursor: pointer;
}
button:disabled { opacity: 0.5; }

.legend { color: var(--dim); font-size: 0.72rem; margin: 8px 2px 14px; }

details {
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: 8px;
  padding: 8px 12px;
  margin-bottom: 8px;
}
summary { cursor: pointer; color: var(--green); }
details ol, details ul { margin: 8px 0 2px; padding-left: 20px; color: var(--dim); font-size: 0.85rem; }
details b { color: var(--text); }
.g { color: var(--green); }
.y { color: var(--yellow); }
.r { color: var(--red); }

footer {
  margin-top: 16px;
  text-align: center;
  color: var(--dim);
  font-size: 0.7rem;
}
